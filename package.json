{
  "name": "blastradius",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Find out what the secrets in your .env can actually do. Live, read-only checks with a red/amber/green report.",
  "license": "MIT",
  "author": "Aitor Aguilar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiagui/Blastradius.git"
  },
  "homepage": "https://github.com/aiagui/Blastradius#readme",
  "bugs": {
    "url": "https://github.com/aiagui/Blastradius/issues"
  },
  "type": "module",
  "bin": {
    "blastradius": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prebuild": "node scripts/gen-connectors.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "pretypecheck": "node scripts/gen-connectors.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prelint": "node scripts/gen-connectors.mjs",
    "lint": "eslint .",
    "pretest": "node scripts/gen-connectors.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "gen:connectors": "node scripts/gen-connectors.mjs",
    "prepublishOnly": "npm run check",
    "fixtures": "node scripts/make-fixture.mjs canary .fixtures/canary && node scripts/make-fixture.mjs basic .fixtures/basic"
  },
  "keywords": [
    "security",
    "secrets",
    "dotenv",
    "env",
    "credentials",
    "blast-radius",
    "secret-scanning",
    "devsecops",
    "github",
    "vercel",
    "stripe",
    "cli",
    "developer-tools"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
